{
  "$schema": "https://opencode.ai/config.json",

  "autoupdate": false,
  "share": "disabled",
  "shell": "bash",

  "model": "openrouter/cohere/north-mini-code:free",

  "instructions": ["AGENTS.md", ".rules/*.md"],

  "plugins": [
    "*",
    "-opencode.provider.*",
    "opencode.provider.openai",
    "opencode.provider.anthropic",
    "opencode.provider.google"
  ],

  "compaction": {
    "auto": true,
    "reserved": 10000
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      ".next/**",
      "target/**",
      "__pycache__/**",
      "*.min.js",
      "*.map",
      "coverage/**",
      "vendor/**"
    ]
  },

  "permission": {
    "*": "allow",

    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "allow",

    "bash": {
      "*": "allow",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "rm -rf /home*": "deny",
      "rm -rf /root*": "deny",
      "rm -rf ..*": "deny",
      "mkfs*": "deny",
      "dd *": "deny",
      "sudo *": "deny",
      ":(){:|:&};:*": "deny"
    },

    "task": { "*": "allow" },
    "external_directory": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "doom_loop": "ask"
  }
}
